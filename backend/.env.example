# Sentinel API keys — copy to `.env` and fill in. Leave blank to run in degraded mode.

# Streaming ASR (https://console.deepgram.com) — free credits on signup
DEEPGRAM_API_KEY=

# Scam classifier — OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
# Classifier model. Default gpt-4o (best recall). Cheaper/faster options: gpt-4.1-mini, gpt-4o-mini.
OPENAI_MODEL=gpt-4o

# TTS warning voice (https://elevenlabs.io)
ELEVENLABS_API_KEY=
# Optional: a specific ElevenLabs voice id. Defaults to a built-in voice.
ELEVENLABS_VOICE_ID=

# Family-alert SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# An SMS-capable Twilio number you own, e.g. +15551234567
TWILIO_FROM_NUMBER=
# Where the SMS / phone-call alert is sent. On a Twilio trial this MUST be a verified number.
FAMILY_ALERT_NUMBER=

# --- Alert channel(s): comma-separated subset of {sms, whatsapp, call} ---
# US SMS is often blocked by A2P 10DLC (error 30034); WhatsApp sandbox is the
# easy demo path; 'call' places a phone call that reads the warning aloud.
TWILIO_ALERT_CHANNELS=sms
# WhatsApp: Twilio sandbox sender (recipient must `join` it first); + your WhatsApp number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
FAMILY_WHATSAPP_NUMBER=
# Voice-capable Twilio number for the 'call' channel (defaults to TWILIO_FROM_NUMBER)
TWILIO_VOICE_FROM=

# --- Tunables (sane defaults; override only if needed) ---
# Risk score (0-100) at which Sentinel intervenes
SENTINEL_RISK_THRESHOLD=70
# Deepgram model
DEEPGRAM_MODEL=nova-2
# Comma-separated allowed CORS origins for the dashboard dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
